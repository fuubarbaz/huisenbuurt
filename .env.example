# Copy to .env and edit. Every key is prefixed WOONAGENT_ and maps to a field
# in app/core/config.py. Anything left out falls back to the default there.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# What counts as a hit
# ---------------------------------------------------------------------------

# Alert threshold, 1.0-10.0. The median Dutch buurt scores around 5.5, so 6.5
# is roughly "clearly better than average". Lower it if you get too few hits.
WOONAGENT_MIN_SCORE_TO_NOTIFY=6.5

# Budget filters. A listing outside these is recorded and marked 'ignored'
# without being enriched, which saves a geocode and six API calls per house.
# A listing whose price or floor area is simply missing is NOT rejected —
# absent is not the same as outside.
# WOONAGENT_MAX_PRICE_EUR=650000
# WOONAGENT_MIN_LIVING_AREA_M2=90

# Geographic filter. Comma-separated cities and/or postcode prefixes; a
# listing must match at least one to be enriched. Unset means unfiltered —
# the whole country — which is almost never what you want for an unattended
# daemon: a real run with no filter alerted on houses in Almelo and
# Leeuwarden for someone whose interest was Amsterdam. Checked before price
# and area, since Huispedia's URL already carries the city and postcode
# before any detail page is fetched, so this costs nothing extra.
# WOONAGENT_REGIONS=Amsterdam,Amstelveen,Diemen,1018,1019

# ---------------------------------------------------------------------------
# Delivery
# ---------------------------------------------------------------------------

# From @BotFather on Telegram. Treat as a credential: anyone holding it can
# post as your bot.
WOONAGENT_TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Where alerts go. Message your bot once, then read the id back from
# https://api.telegram.org/bot<TOKEN>/getUpdates
WOONAGENT_TELEGRAM_CHAT_ID=-1001234567890

# true = run the whole loop but send nothing. The right way to try it out,
# and to see what would have been alerted before committing to a threshold.
WOONAGENT_DRY_RUN=false

# ---------------------------------------------------------------------------
# Pace
# ---------------------------------------------------------------------------

# Randomised interval between poll cycles, in seconds (default 5-15 minutes).
WOONAGENT_SCRAPE_INTERVAL_MIN_SECONDS=300
WOONAGENT_SCRAPE_INTERVAL_MAX_SECONDS=900

# Upper bound on listings processed per cycle. Keeps a first run against a busy
# day from grinding for hours before you see anything.
WOONAGENT_MAX_LISTINGS_PER_CYCLE=25

# Politeness pause between detail-page fetches, in seconds.
WOONAGENT_REQUEST_DELAY_MIN_SECONDS=2
WOONAGENT_REQUEST_DELAY_MAX_SECONDS=6

# Optional: RVO EP-Online key, for energy labels. Free to register at
# https://www.ep-online.nl — without it the label is simply absent. Build year
# and floor area come from the BAG and need no key.
# WOONAGENT_EPONLINE_API_KEY=your-key

# Optional: OpenRouteService key, for public-transport commute times. Free at
# openrouteservice.org. Car and bike need no key. Without this the transit
# column is absent — no keyless door-to-door transit router exists for NL.
# WOONAGENT_ORS_API_KEY=your-key

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

WOONAGENT_DATABASE_URL=sqlite+aiosqlite:///./data/woonagent.db
WOONAGENT_LOG_LEVEL=INFO

# Optional: lets a site operator contact you instead of silently blocking the
# agent. Sent as the From header alongside the User-Agent.
# WOONAGENT_CONTACT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Public exposure
# ---------------------------------------------------------------------------

# Leave unset on a laptop — unset means no gate, so nothing changes locally.
# Set it on anything reachable from the internet: one /score fans out to about
# a dozen requests against PDOK, CBS, the BAG and two volunteer-run routing
# servers, so an ungated endpoint is an amplifier aimed at free infrastructure
# that is not yours. Generate one with `openssl rand -hex 24`, then open the UI
# once at /ui?key=<token> and the cookie carries you from there.
# WOONAGENT_ACCESS_TOKEN=

# Request budget, active only alongside the access token above. The token
# stops a stranger from using the API; this stops even a token holder from
# costing more than intended — on a host that scales to zero (Fly), a machine
# kept busy never goes idle and never stops billing, so a leaked token or a
# runaway script is real money without this. Defaults are generous for
# interactive use; tighten them if you want a harder ceiling.
# WOONAGENT_RATE_LIMIT_PER_MINUTE=30
# WOONAGENT_RATE_LIMIT_BURST=10
