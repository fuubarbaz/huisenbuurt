__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Personal runtime state — regenerated locally, never shipped in the repo.
# Specific filenames, not data/*.db: schools.db is a build artifact the app
# reads at startup (see Dockerfile), not local state, and a broad glob here
# would silently exclude it from every clone too.
data/woonagent.db
data/woonagent.db-wal
data/woonagent.db-shm

# The national map's DuckDB file (tens of MB, regenerated by a multi-hour
# script) is deliberately never in git or the Docker image — the deployed
# copy goes straight onto the Fly volume via `fly ssh sftp put`, same as
# woonagent.db's own lifecycle. See national_map_store.py's module docstring.
data/*.duckdb
.pytest_cache/
.DS_Store

# uv.lock is deliberately NOT ignored — it is the real version pin.
